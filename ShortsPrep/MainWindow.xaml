<Window x:Class="ShortsPrep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShortsPrep — Tututte" Height="760" Width="920"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🎞️" FontSize="28" Margin="0,0,10,0"/>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ShortsPrep" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="FfmpegVersionText" Text="  (ffmpeg : ...)" FontSize="12"
                               Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                </StackPanel>
                <TextBlock Text="Prépare tes vidéos pour TikTok, Reels et YouTube Shorts, sans perte de qualité."
                           FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Mode source -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="1 · D'OÙ PART-ON ?" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton x:Name="ModeVideoRadio" Content="Depuis une vidéo existante" GroupName="Mode"
                                 IsChecked="True" Margin="0,0,24,0" Checked="ModeRadio_Changed"/>
                    <RadioButton x:Name="ModeImageAudioRadio" Content="Depuis une image + un son"
                                 GroupName="Mode" Checked="ModeRadio_Changed"/>
                </StackPanel>

                <!-- Mode vidéo -->
                <StackPanel x:Name="VideoModePanel" Orientation="Horizontal">
                    <Button x:Name="BrowseButton" Content="📂 Choisir une vidéo..." Style="{StaticResource SecondaryButton}" Click="BrowseButton_Click"/>
                    <TextBlock x:Name="SelectedFileText" Text="Aucun fichier sélectionné"
                               Foreground="{StaticResource SubTextBrush}" Margin="14,0,14,0" VerticalAlignment="Center"/>
                    <Button x:Name="TrimVideoButton" Content="✂ Rogner / sélectionner une partie..." Style="{StaticResource SecondaryButton}"
                            Click="TrimVideoButton_Click" IsEnabled="False" Margin="0,0,10,0"/>
                    <TextBlock x:Name="VideoTrimText" Text="" Foreground="{StaticResource AccentGoldBrush}"
                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Button x:Name="OpenEditorButton" Content="🎬 Éditeur avancé..." Style="{StaticResource SecondaryButton}"
                            Click="OpenEditorButton_Click" IsEnabled="False"/>
                </StackPanel>

                <!-- Mode image + audio -->
                <StackPanel x:Name="ImageAudioModePanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="BrowseImageButton" Content="🖼 Choisir une image..." Style="{StaticResource SecondaryButton}" Click="BrowseImageButton_Click"/>
                        <TextBlock x:Name="SelectedImageText" Text="Aucune image sélectionnée"
                                   Foreground="{StaticResource SubTextBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="BrowseAudioButton" Content="🎵 Choisir un son..." Style="{StaticResource SecondaryButton}" Click="BrowseAudioButton_Click"/>
                        <TextBlock x:Name="SelectedAudioText" Text="Aucun son sélectionné"
                                   Foreground="{StaticResource SubTextBrush}" Margin="14,0,14,0" VerticalAlignment="Center"/>
                        <Button x:Name="TrimAudioButton" Content="✂ Rogner..." Style="{StaticResource SecondaryButton}" Click="TrimAudioButton_Click" IsEnabled="False"/>
                        <TextBlock x:Name="AudioTrimText" Text="" Foreground="{StaticResource AccentGoldBrush}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox x:Name="FlacMasterCheck" Content="Créer aussi un fichier maître 100% sans perte (image + audio FLAC intégré, .mkv)"
                              IsChecked="True" Margin="0,0,0,10"/>

                    <Separator Margin="0,4,0,12" Background="{StaticResource BorderBrush2}"/>
                    <TextBlock Text="MÉTHODE SIMPLE (commande directe, audio copié sans ré-encodage)" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="ChooseSimpleOutputButton" Content="Choisir le nom du fichier..." Style="{StaticResource SecondaryButton}"
                                Click="ChooseSimpleOutputButton_Click" Margin="0,0,14,0"/>
                        <TextBlock x:Name="SimpleOutputText" Text="Aucun fichier de sortie choisi"
                                   Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="StartSimpleCombineButton" Content="Démarrer" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" IsEnabled="False" Click="StartSimpleCombineButton_Click"/>
                    <TextBlock Text="La vidéo générée durera exactement la durée du son (max 60s en portrait, illimité en paysage/maître)."
                               Foreground="{StaticResource SubTextBrush}" FontStyle="Italic" FontSize="11" Margin="0,10,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Options qualité -->
        <Border Grid.Row="2" Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="2 · FORMAT ET QUALITÉ" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="OrientationPortrait" Content="Portrait 9:16 — short (TikTok / Reels / YouTube Shorts, même format)"
                                 IsChecked="True" GroupName="Orientation" Margin="0,0,20,0" Checked="OrientationRadio_Changed"/>
                    <RadioButton x:Name="OrientationLandscape" Content="Paysage 16:9 (format classique)"
                                 GroupName="Orientation" Checked="OrientationRadio_Changed"/>
                </StackPanel>
                <CheckBox x:Name="NoDurationLimitCheck"
                          Content="Garder la vidéo entière en portrait (ne pas couper à 60s)" Margin="0,0,0,12"/>

                <Separator Margin="0,0,0,12" Background="{StaticResource BorderBrush2}"/>
                <TextBlock Text="QUALITÉ VIDÉO" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="QualityVisualLossless" Content="Visuellement sans perte (recommandé)"
                                 IsChecked="True" GroupName="Quality" Margin="0,0,20,0"/>
                    <RadioButton x:Name="QualityTrueLossless" Content="100% sans perte (fichiers très volumineux)"
                                 GroupName="Quality" Margin="0,0,20,0"/>
                    <RadioButton x:Name="QualityCopy" Content="Copier si déjà compatible (le plus rapide)" GroupName="Quality"/>
                </StackPanel>

                <Separator Margin="0,0,0,12" Background="{StaticResource BorderBrush2}"/>
                <TextBlock Text="AUDIO D'ORIGINE (copie maître, aucune perte)" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox x:Name="ExtractAudioCheck" Content="Extraire une copie audio sans perte" IsChecked="True" Margin="0,0,20,0"/>
                    <RadioButton x:Name="AudioWav" Content="WAV (24-bit)" IsChecked="True" GroupName="AudioFormat" Margin="0,0,20,0"/>
                    <RadioButton x:Name="AudioFlac" Content="FLAC" GroupName="AudioFormat"/>
                </StackPanel>

                <Separator Margin="0,0,0,12" Background="{StaticResource BorderBrush2}"/>
                <TextBlock Text="MOUVEMENT DE CAMÉRA ET RÉACTIVITÉ À LA MUSIQUE" Foreground="{StaticResource SubTextBrush}" FontSize="12"
                           Margin="0,0,0,8" TextWrapping="Wrap"/>
                <CheckBox x:Name="KenBurnsCheck" Content="Mouvement de caméra (zoom lent + léger travelling, façon Ken Burns)"
                          Checked="MotionCheck_Changed" Unchecked="MotionCheck_Changed"/>
                <StackPanel x:Name="KenBurnsIntensityPanel" Orientation="Horizontal" Margin="24,4,0,8" Visibility="Collapsed">
                    <TextBlock Text="Intensité :" Foreground="{StaticResource SubTextBrush}" Width="70" VerticalAlignment="Center"/>
                    <Slider x:Name="KenBurnsIntensitySlider" Minimum="0" Maximum="100" Value="50" Width="220"/>
                </StackPanel>
                <CheckBox x:Name="BassReactiveCheck" Content="Le zoom réagit aux basses (pulsation sur les kicks/basses détectées)"
                          Checked="MotionCheck_Changed" Unchecked="MotionCheck_Changed"/>
                <StackPanel x:Name="BassSensitivityPanel" Orientation="Horizontal" Margin="24,4,0,4" Visibility="Collapsed">
                    <TextBlock Text="Sensibilité :" Foreground="{StaticResource SubTextBrush}" Width="70" VerticalAlignment="Center"/>
                    <Slider x:Name="BassSensitivitySlider" Minimum="0" Maximum="100" Value="60" Width="220"/>
                </StackPanel>
                <TextBlock Text="Analyse l'énergie des basses de l'audio (pas une détection de rythme/BPM parfaite : ça pulse fort sur les kicks/basses marquées)."
                           Foreground="{StaticResource SubTextBrush}" FontStyle="Italic" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Publication -->
        <Border x:Name="PublishBorder" Grid.Row="3" Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="3 · APRÈS GÉNÉRATION" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Ouvrir directement les pages de publication (un seul fichier .mp4 convient aux trois, même format) :"
                           Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="TikTokCheck" Content="TikTok" IsChecked="True" Margin="0,0,20,0"/>
                    <CheckBox x:Name="InstagramCheck" Content="Instagram Reels" IsChecked="True" Margin="0,0,20,0"/>
                    <CheckBox x:Name="YoutubeCheck" Content="YouTube Shorts" IsChecked="True"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Emplacement de sortie -->
        <Border Grid.Row="4" Style="{StaticResource SectionCard}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📁 Dossier de sortie :" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="ChooseOutputButton" Content="Choisir..." Style="{StaticResource SecondaryButton}" Click="ChooseOutputButton_Click"/>
                <TextBlock x:Name="OutputDirText" Text="(par défaut : à côté du fichier source)"
                           Foreground="{StaticResource SubTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Journal -->
        <Border Grid.Row="5" Height="200" Style="{StaticResource SectionCard}">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
            </ScrollViewer>
        </Border>

        <!-- Barre de progression -->
        <StackPanel Grid.Row="6" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="ProgressBarCtrl" Grid.Column="0" Height="10" Minimum="0" Maximum="100" Value="0"
                             Visibility="Collapsed" Foreground="{StaticResource AccentGoldBrush}"/>
                <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Text="" Foreground="{StaticResource TextBrush}"
                           FontWeight="Bold" Margin="10,0,0,0" Visibility="Collapsed"/>
            </Grid>
            <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OpenOutputButton" Content="Ouvrir le dossier de sortie" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0" Click="OpenOutputButton_Click" IsEnabled="False"/>
            <Button x:Name="ProcessButton" Content="🚀 Traiter et préparer" Style="{StaticResource PrimaryButton}" Click="ProcessButton_Click"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
