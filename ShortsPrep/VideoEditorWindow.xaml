<Window x:Class="ShortsPrep.VideoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Éditeur vidéo sans perte" Height="820" Width="1000"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="360"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Éditeur vidéo sans perte"
                   Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- Aperçu -->
        <Border Grid.Row="1" Grid.Column="0" Background="Black" CornerRadius="6" Margin="0,0,12,0">
            <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          Stretch="Uniform" MediaOpened="Media_MediaOpened" MediaFailed="Media_MediaFailed"/>
        </Border>

        <!-- Panneau effets -->
        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top">
            <TextBlock Text="Effets" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="0,0,0,8"/>

            <TextBlock Text="Luminosité" Foreground="{StaticResource SubTextBrush}"/>
            <Slider x:Name="BrightnessSlider" Minimum="-50" Maximum="50" Value="0"/>

            <TextBlock Text="Contraste" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0"/>
            <Slider x:Name="ContrastSlider" Minimum="50" Maximum="150" Value="100"/>

            <TextBlock Text="Saturation" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0"/>
            <Slider x:Name="SaturationSlider" Minimum="0" Maximum="200" Value="100"/>

            <TextBlock Text="Rotation" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,4"/>
            <ComboBox x:Name="RotationCombo" SelectedIndex="0">
                <ComboBoxItem Content="Aucune"/>
                <ComboBoxItem Content="90° horaire"/>
                <ComboBoxItem Content="180°"/>
                <ComboBoxItem Content="90° anti-horaire"/>
            </ComboBox>

            <Separator Margin="0,12"/>
            <CheckBox x:Name="KenBurnsCheck" Content="Mouvement de caméra (Ken Burns)"
                      Foreground="{StaticResource TextBrush}" Checked="MotionCheck_Changed" Unchecked="MotionCheck_Changed"/>
            <StackPanel x:Name="KenBurnsIntensityPanel" Margin="16,4,0,4" Visibility="Collapsed">
                <TextBlock Text="Intensité" Foreground="{StaticResource SubTextBrush}"/>
                <Slider x:Name="KenBurnsIntensitySlider" Minimum="0" Maximum="100" Value="50"/>
            </StackPanel>
            <CheckBox x:Name="BassReactiveCheck" Content="Réagit aux basses"
                      Foreground="{StaticResource TextBrush}" Checked="MotionCheck_Changed" Unchecked="MotionCheck_Changed"/>
            <StackPanel x:Name="BassSensitivityPanel" Margin="16,4,0,4" Visibility="Collapsed">
                <TextBlock Text="Sensibilité" Foreground="{StaticResource SubTextBrush}"/>
                <Slider x:Name="BassSensitivitySlider" Minimum="0" Maximum="100" Value="60"/>
            </StackPanel>

            <Separator Margin="0,12"/>
            <TextBlock Text="Mode d'export" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="0,0,0,6"/>
            <RadioButton x:Name="FastModeRadio" Content="Rapide (copie de flux, coupes ~image clé)"
                         GroupName="ExportMode" Foreground="{StaticResource TextBrush}" IsChecked="True"
                         Checked="ExportMode_Changed"/>
            <RadioButton x:Name="PreciseModeRadio" Content="Précis (ré-encodage 100% sans perte, plus lent)"
                         GroupName="ExportMode" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"
                         Checked="ExportMode_Changed"/>
            <TextBlock x:Name="ExportModeHint" Text="" Foreground="{StaticResource SubTextBrush}"
                       FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Transport / marquage de segments -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PlayPauseButton" Content="Lecture/Pause" Padding="10,6" Click="PlayPauseButton_Click" Margin="0,0,10,0"/>
                <TextBlock x:Name="CurrentTimeText" Text="00:00.0" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Width="70"/>
                <Slider x:Name="ScrubberSlider" Width="380" Minimum="0" Maximum="1" ValueChanged="ScrubberSlider_ValueChanged"/>
                <TextBlock x:Name="TotalTimeText" Text="00:00.0" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="MarkStartButton" Content="Marquer début" Padding="10,6" Click="MarkStartButton_Click" Margin="0,0,8,0"/>
                <TextBlock x:Name="MarkStartText" Text="Début : -" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button x:Name="MarkEndButton" Content="Marquer fin" Padding="10,6" Click="MarkEndButton_Click" Margin="0,0,8,0"/>
                <TextBlock x:Name="MarkEndText" Text="Fin : -" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button x:Name="AddSegmentButton" Content="+ Ajouter le segment à garder" Padding="10,6"
                        Background="{StaticResource AccentBrush}" Foreground="White" Click="AddSegmentButton_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Liste des segments -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}" CornerRadius="8"
                Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Segments à garder (dans l'ordre du montage final)" Foreground="{StaticResource TextBrush}"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListBox x:Name="SegmentsList" Height="120" Background="Transparent" BorderThickness="0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Monter" Padding="10,4" Margin="0,0,8,0" Click="MoveSegmentUp_Click"/>
                    <Button Content="Descendre" Padding="10,4" Margin="0,0,8,0" Click="MoveSegmentDown_Click"/>
                    <Button Content="Supprimer" Padding="10,4" Click="RemoveSegmentButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Journal + actions -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Border Height="140" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="10">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" FontFamily="Consolas"/>
                </ScrollViewer>
            </Border>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="ProgressBarCtrl" Grid.Column="0" Height="10" Minimum="0" Maximum="100"
                             Visibility="Collapsed" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Text="" Foreground="{StaticResource TextBrush}"
                           FontWeight="Bold" Margin="10,0,0,0" Visibility="Collapsed"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Fermer" Padding="14,8" Margin="0,0,10,0" Click="CloseButton_Click"/>
                <Button x:Name="ExportButton" Content="Exporter..." Padding="20,10" FontWeight="Bold"
                        Background="{StaticResource AccentBrush}" Foreground="White" Click="ExportButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
