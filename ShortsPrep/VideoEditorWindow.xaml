<Window x:Class="ShortsPrep.VideoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Éditeur vidéo sans perte" Height="880" Width="1100"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🎬" FontSize="24" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="Éditeur vidéo" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Coupes, effets, export sans perte" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- Colonne gauche : aperçu + timeline + segments -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,0">

            <Border Style="{StaticResource SectionCard}" Padding="0" ClipToBounds="True">
                <Grid Height="380">
                    <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                  Stretch="Uniform" MediaOpened="Media_MediaOpened" MediaFailed="Media_MediaFailed"/>
                    <Border x:Name="LoadingOverlay" Background="#CC1A1512">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="28" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LoadingText" Text="Préparation de l'aperçu..."
                                       Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="(l'export utilise toujours le fichier d'origine en pleine qualité)"
                                       Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Transport -->
            <StackPanel Orientation="Horizontal" Margin="4,0,0,10">
                <Button x:Name="PlayPauseButton" Content="▶" Width="42" Height="36" FontSize="14"
                        Style="{StaticResource SecondaryButton}" Click="PlayPauseButton_Click" Margin="0,0,10,0"/>
                <TextBlock x:Name="CurrentTimeText" Text="00:00.0" Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center" Width="60" FontFamily="Consolas"/>
                <TextBlock Text="/" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="TotalTimeText" Text="00:00.0" Foreground="{StaticResource SubTextBrush}"
                           VerticalAlignment="Center" FontFamily="Consolas"/>
            </StackPanel>

            <!-- Timeline visuelle -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="TIMELINE" Style="{StaticResource SectionTitle}"/>
                    <Border Background="#1F1815" CornerRadius="6" Height="64" ClipToBounds="True">
                        <Canvas x:Name="TimelineCanvas" Background="Transparent"
                                MouseLeftButtonDown="TimelineCanvas_MouseDown"
                                MouseMove="TimelineCanvas_MouseMove" MouseLeftButtonUp="TimelineCanvas_MouseUp"
                                SizeChanged="TimelineCanvas_SizeChanged"/>
                    </Border>
                    <TextBlock Text="Clique sur la timeline pour te déplacer. Les bandes dorées sont les segments déjà ajoutés."
                               Foreground="{StaticResource SubTextBrush}" FontSize="11" FontStyle="Italic" Margin="0,8,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="✂  Marquer début" Style="{StaticResource SecondaryButton}"
                                Click="MarkStartButton_Click" Margin="0,0,8,0"/>
                        <Button Content="✂  Marquer fin" Style="{StaticResource SecondaryButton}"
                                Click="MarkEndButton_Click" Margin="0,0,16,0"/>
                        <TextBlock x:Name="MarkRangeText" Text="Aucun point marqué"
                                   Foreground="{StaticResource AccentGoldBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="+ Ajouter le segment" Style="{StaticResource PrimaryButton}"
                                Click="AddSegmentButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Segments -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="SEGMENTS À GARDER (ordre du montage final)" Style="{StaticResource SectionTitle}"/>
                    <ListBox x:Name="SegmentsList" Height="110" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="▲ Monter" Style="{StaticResource SecondaryButton}" Click="MoveSegmentUp_Click" Margin="0,0,8,0"/>
                        <Button Content="▼ Descendre" Style="{StaticResource SecondaryButton}" Click="MoveSegmentDown_Click" Margin="0,0,8,0"/>
                        <Button Content="🗑 Supprimer" Style="{StaticResource SecondaryButton}" Click="RemoveSegmentButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Colonne droite : effets -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SectionCard}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="COULEUR" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Luminosité" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                <Slider x:Name="BrightnessSlider" Minimum="-50" Maximum="50" Value="0" Margin="0,2,0,8"/>
                <TextBlock Text="Contraste" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                <Slider x:Name="ContrastSlider" Minimum="50" Maximum="150" Value="100" Margin="0,2,0,8"/>
                <TextBlock Text="Saturation" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                <Slider x:Name="SaturationSlider" Minimum="0" Maximum="200" Value="100" Margin="0,2,0,8"/>
                <TextBlock Text="Rotation" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="RotationCombo" SelectedIndex="0" Margin="0,0,0,4">
                    <ComboBoxItem Content="Aucune"/>
                    <ComboBoxItem Content="90° horaire"/>
                    <ComboBoxItem Content="180°"/>
                    <ComboBoxItem Content="90° anti-horaire"/>
                </ComboBox>

                <Separator Margin="0,14" Background="{StaticResource BorderBrush2}"/>
                <TextBlock Text="MOUVEMENT" Style="{StaticResource SectionTitle}"/>
                <CheckBox x:Name="KenBurnsCheck" Content="Mouvement de caméra (Ken Burns)"
                          Checked="MotionCheck_Changed" Unchecked="MotionCheck_Changed"/>
                <StackPanel x:Name="KenBurnsIntensityPanel" Margin="18,4,0,6" Visibility="Collapsed">
                    <TextBlock Text="Intensité" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                    <Slider x:Name="KenBurnsIntensitySlider" Minimum="0" Maximum="100" Value="50"/>
                </StackPanel>
                <CheckBox x:Name="BassReactiveCheck" Content="Réagit aux basses"
                          Checked="MotionCheck_Changed" Unchecked="MotionCheck_Changed"/>
                <StackPanel x:Name="BassSensitivityPanel" Margin="18,4,0,4" Visibility="Collapsed">
                    <TextBlock Text="Sensibilité" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                    <Slider x:Name="BassSensitivitySlider" Minimum="0" Maximum="100" Value="60"/>
                </StackPanel>

                <Separator Margin="0,14" Background="{StaticResource BorderBrush2}"/>
                <TextBlock Text="EXPORT" Style="{StaticResource SectionTitle}"/>
                <RadioButton x:Name="FastModeRadio" Content="Rapide (copie de flux)"
                             GroupName="ExportMode" IsChecked="True" Checked="ExportMode_Changed" Margin="0,0,0,6"/>
                <RadioButton x:Name="PreciseModeRadio" Content="Précis (100% sans perte)"
                             GroupName="ExportMode" Checked="ExportMode_Changed"/>
                <TextBlock x:Name="ExportModeHint" Text="" Foreground="{StaticResource SubTextBrush}"
                           FontStyle="Italic" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Journal -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource SectionCard}" Height="130">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
            </ScrollViewer>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="3" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar x:Name="ProgressBarCtrl" Width="260" Height="10" Minimum="0" Maximum="100"
                             Visibility="Collapsed" Foreground="{StaticResource AccentGoldBrush}"/>
                <TextBlock x:Name="ProgressPercentText" Text="" Foreground="{StaticResource TextBrush}"
                           FontWeight="Bold" Margin="10,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Fermer" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="CloseButton_Click"/>
                <Button x:Name="ExportButton" Content="Exporter..." Style="{StaticResource PrimaryButton}" Click="ExportButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
