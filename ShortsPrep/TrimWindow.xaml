<Window x:Class="ShortsPrep.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choisir la partie à garder" Height="600" Width="680"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="320"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="✂️" FontSize="20" Margin="0,0,8,0"/>
            <TextBlock Text="Choisis le début et la fin à conserver"
                       Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="Bold"/>
        </StackPanel>

        <Border Grid.Row="1" Background="Black" CornerRadius="8" ClipToBounds="True">
            <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          Stretch="Uniform" MediaOpened="Media_MediaOpened" MediaFailed="Media_MediaFailed"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Début" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                <Slider x:Name="StartSlider" Minimum="0" Maximum="1" ValueChanged="StartSlider_ValueChanged"/>
                <TextBlock x:Name="StartLabel" Text="00:00.0" Foreground="{StaticResource TextBrush}" FontFamily="Consolas"/>

                <TextBlock Text="Fin" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,10,0,0"/>
                <Slider x:Name="EndSlider" Minimum="0" Maximum="1" ValueChanged="EndSlider_ValueChanged"/>
                <TextBlock x:Name="EndLabel" Text="00:00.0" Foreground="{StaticResource TextBrush}" FontFamily="Consolas"/>

                <TextBlock x:Name="DurationLabel" Text="Durée sélectionnée : 0.0s"
                           Foreground="{StaticResource AccentGoldBrush}" FontWeight="Bold" Margin="0,12,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="▶ Lire l'aperçu" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="PreviewButton_Click"/>
                    <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="CancelButton_Click"/>
                    <Button Content="Valider" Style="{StaticResource PrimaryButton}" Click="ValidateButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
